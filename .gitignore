# =============================================
# AAMRE - .gitignore
# =============================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
wheels/
*.whl

# Entornos virtuales
.venv/
venv/
env/
ENV/
.env

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs generados (conservar carpeta, ignorar contenido)
logs/*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Assets generados automáticamente
assets/*.png
assets/*.jpg

# Archivos temporales del sistema
*.tmp
*.bak
*.swp
*~
